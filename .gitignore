# Terraform state — contains sensitive resource details, never commit
terraform.tfstate
terraform.tfstate.backup
*.tfstate
*.tfstate.*

# Real variable values — contains project IDs, emails, secrets
terraform.tfvars

# Terraform internals — lock file IS committed (pins provider versions)
.terraform/

# Build artifacts — generated by archive_file data source
.build/

# Claude Code settings
.claude/

# macOS
.DS_Store

# Editor
.idea/
.vscode/
*.swp
*.png
*.drawio
*-arch.yaml
